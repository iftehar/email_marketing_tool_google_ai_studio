rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Users ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
        incoming().diff(existing()).affectedKeys().hasOnly(['name']);
      
      function isValidUser(data) {
        return data.keys().hasAll(['name', 'email', 'createdAt']) && 
               data.keys().size() == 3 &&
               data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
               data.email is string && data.email.size() > 0 && data.email.size() < 100 &&
               data.email == request.auth.token.email;
      }
    }

    // --- Domains ---
    match /domains/{domainId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidDomain(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidDomain(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['spf', 'dkim', 'dmarc', 'updatedAt']);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;

      function isValidDomain(data) {
        return data.keys().hasAll(['name', 'userId', 'createdAt']) &&
               data.name is string && data.name.size() > 0 && data.name.size() < 255 &&
               data.userId == request.auth.uid;
      }
    }

    // --- Contacts ---
    match /contacts/{contactId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidContact(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidContact(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;

      function isValidContact(data) {
        return data.keys().hasAll(['email', 'status', 'source', 'added', 'userId']) &&
               data.email is string && data.email.size() > 0 && data.email.size() < 255 &&
               data.userId == request.auth.uid;
      }
    }

    // --- Campaigns ---
    match /campaigns/{campaignId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidCampaign(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidCampaign(incoming()) &&
        (
          // Action: Update Progress
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'delivery', 'sentTo', 'time']) ||
          // Action: Edit metadata
          incoming().diff(existing()).affectedKeys().hasOnly(['subject'])
        );
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;

      function isValidCampaign(data) {
        return data.keys().hasAll(['subject', 'sentTo', 'status', 'time', 'delivery', 'userId']) &&
               data.subject is string && data.subject.size() > 0 && data.subject.size() < 255 &&
               data.userId == request.auth.uid;
      }
    }
  }
}
